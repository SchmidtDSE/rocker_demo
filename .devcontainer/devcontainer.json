{
  "name": "rocker-demo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": false,
  "remoteUser": "rstudio",
  "containerEnv": {
    "DISABLE_AUTH": "true",
    "ROOT": "true"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "RStudio", "requireLocalPort": true }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "reditorsupport.r"
      ]
    }
  }
}